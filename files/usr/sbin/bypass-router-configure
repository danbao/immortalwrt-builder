#!/bin/sh

set -eu

INIT_DIR="${BYPASS_INIT_DIR:-/etc/init.d}"

fail() {
	printf 'ERROR: %s\n' "$*" >&2
	exit 1
}

valid_ipv4() {
	awk -F. '
		NF != 4 { exit 1 }
		{
			for (i = 1; i <= 4; i++)
				if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255)
					exit 1
		}
	' <<EOF
$1
EOF
}

if [ "$#" -ne 5 ] || [ "$5" != '--confirm' ]; then
	fail "usage: $0 STAGING_IP TARGET_IP GATEWAY TRUSTED_CIDR --confirm"
fi

staging_ip="$1"
target_ip="$2"
gateway="$3"
trusted_cidr="$4"
trusted_network="${trusted_cidr%/*}"
prefix="${trusted_cidr#*/}"

valid_ipv4 "$staging_ip" || fail 'invalid staging IPv4 address'
valid_ipv4 "$target_ip" || fail 'invalid target IPv4 address'
valid_ipv4 "$gateway" || fail 'invalid gateway IPv4 address'
valid_ipv4 "$trusted_network" || fail 'invalid trusted network IPv4 address'
[ "$prefix" = '24' ] || fail 'only a /24 LAN is currently supported'
[ "$staging_ip" != "$target_ip" ] || fail 'staging and target addresses must differ'

uci -q set bypass_router.main='migration'
uci -q set "bypass_router.main.staging_ip=${staging_ip}"
uci -q set "bypass_router.main.target_ip=${target_ip}"
uci -q set "bypass_router.main.gateway=${gateway}"
uci -q set "bypass_router.main.trusted_cidr=${trusted_cidr}"
uci -q commit bypass_router

uci -q set network.lan.proto='static'
uci -q set "network.lan.ipaddr=${staging_ip}"
uci -q set network.lan.netmask='255.255.255.0'
uci -q set "network.lan.gateway=${gateway}"
uci -q delete network.lan.dns
uci -q add_list "network.lan.dns=${gateway}"
uci -q commit network

uci -q set firewall.bypass_mgmt_allow='rule'
uci -q set firewall.bypass_mgmt_allow.name='Allow-bypass-router-management'
uci -q set firewall.bypass_mgmt_allow.src='lan'
uci -q set "firewall.bypass_mgmt_allow.src_ip=${trusted_cidr}"
uci -q set firewall.bypass_mgmt_allow.proto='tcp'
uci -q set firewall.bypass_mgmt_allow.dest_port='22 80 443 2023'
uci -q set firewall.bypass_mgmt_allow.target='ACCEPT'
uci -q set firewall.bypass_mgmt_reject='rule'
uci -q set firewall.bypass_mgmt_reject.name='Reject-untrusted-management'
uci -q set firewall.bypass_mgmt_reject.src='lan'
uci -q set firewall.bypass_mgmt_reject.proto='tcp'
uci -q set firewall.bypass_mgmt_reject.dest_port='22 80 443 2023'
uci -q set firewall.bypass_mgmt_reject.target='REJECT'
uci -q commit firewall

if uci -q get uhttpd.main >/dev/null; then
	uci -q delete uhttpd.main.listen_http
	uci -q add_list "uhttpd.main.listen_http=${staging_ip}:80"
	uci -q delete uhttpd.main.listen_https
	uci -q add_list "uhttpd.main.listen_https=${staging_ip}:443"
	uci -q set uhttpd.main.redirect_https='1'
	uci -q commit uhttpd
fi
if uci -q get daed.config >/dev/null; then
	uci -q set "daed.config.listen_addr=${staging_ip}:2023"
	uci -q commit daed
fi

printf 'Applying staging address %s. Reconnect after the network reload.\n' "$staging_ip"
"${INIT_DIR}/firewall" restart
"${INIT_DIR}/network" reload
"${INIT_DIR}/uhttpd" restart >/dev/null 2>&1 || true
"${INIT_DIR}/daed" restart >/dev/null 2>&1 || true
