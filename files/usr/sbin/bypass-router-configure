#!/bin/sh

set -eu

INIT_DIR="${BYPASS_INIT_DIR:-/etc/init.d}"
DEFAULT_BRIDGE_PORTS='eth0,eth1,eth2,eth3,eth4,eth5'

fail() {
	printf 'ERROR: %s\n' "$*" >&2
	exit 1
}

valid_ipv4() {
	awk -F. '
		NF != 4 { exit 1 }
		{
			for (i = 1; i <= 4; i++)
				if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255)
					exit 1
		}
	' <<EOF
$1
EOF
}

usage() {
	fail "usage: $0 STAGING_IP TARGET_IP GATEWAY TRUSTED_CIDR [--ports PORT1,PORT2,...] --confirm"
}

[ "$#" -ge 5 ] || usage

staging_ip="$1"
target_ip="$2"
gateway="$3"
trusted_cidr="$4"
shift 4

bridge_ports="$DEFAULT_BRIDGE_PORTS"
confirmed=0
while [ "$#" -gt 0 ]; do
	case "$1" in
		--ports)
			[ "$#" -ge 2 ] || usage
			bridge_ports="$2"
			shift 2
		;;
		--confirm)
			confirmed=1
			shift
		;;
		*) usage ;;
	esac
done
[ "$confirmed" = '1' ] || usage

case "$bridge_ports" in
	''|,*|*,|*,,*) fail 'invalid bridge port list' ;;
esac

old_ifs="$IFS"
IFS=','
# The unquoted expansion deliberately splits the validated comma-separated list.
# Disable pathname expansion so a port such as '*' cannot turn into filenames.
set -f
# shellcheck disable=SC2086
set -- $bridge_ports
set +f
IFS="$old_ifs"
[ "$#" -ge 2 ] || fail 'at least two bridge ports are required'
for port in "$@"; do
	case "$port" in
		''|*[!A-Za-z0-9_.:-]*) fail "invalid bridge port: $port" ;;
	esac
done
trusted_network="${trusted_cidr%/*}"
prefix="${trusted_cidr#*/}"

valid_ipv4 "$staging_ip" || fail 'invalid staging IPv4 address'
valid_ipv4 "$target_ip" || fail 'invalid target IPv4 address'
valid_ipv4 "$gateway" || fail 'invalid gateway IPv4 address'
valid_ipv4 "$trusted_network" || fail 'invalid trusted network IPv4 address'
[ "$prefix" = '24' ] || fail 'only a /24 LAN is currently supported'
[ "$staging_ip" != "$target_ip" ] || fail 'staging and target addresses must differ'

uci -q set bypass_router.main='migration'
uci -q set "bypass_router.main.staging_ip=${staging_ip}"
uci -q set "bypass_router.main.target_ip=${target_ip}"
uci -q set "bypass_router.main.gateway=${gateway}"
uci -q set "bypass_router.main.trusted_cidr=${trusted_cidr}"
uci -q delete bypass_router.main.bridge_port
for port in "$@"; do
	uci -q add_list "bypass_router.main.bridge_port=${port}"
done
uci -q commit bypass_router

bridge_section="$(uci -q show network | sed -n "s/^\(network\.[^.]*\)\.name='br-lan'$/\1/p" | head -n 1)"
if [ -z "$bridge_section" ]; then
	uci -q set network.br_lan='device'
	uci -q set network.br_lan.name='br-lan'
	uci -q set network.br_lan.type='bridge'
	bridge_section='network.br_lan'
fi
uci -q set network.lan.device='br-lan'
uci -q delete "${bridge_section}.ports"
for port in "$@"; do
	uci -q add_list "${bridge_section}.ports=${port}"
done

uci -q set network.lan.proto='static'
uci -q set "network.lan.ipaddr=${staging_ip}"
uci -q set network.lan.netmask='255.255.255.0'
uci -q set "network.lan.gateway=${gateway}"
uci -q delete network.lan.dns
uci -q add_list "network.lan.dns=${gateway}"
uci -q commit network

uci -q set firewall.bypass_mgmt_allow='rule'
uci -q set firewall.bypass_mgmt_allow.name='Allow-bypass-router-management'
uci -q set firewall.bypass_mgmt_allow.src='lan'
uci -q set "firewall.bypass_mgmt_allow.src_ip=${trusted_cidr}"
uci -q set firewall.bypass_mgmt_allow.proto='tcp'
uci -q set firewall.bypass_mgmt_allow.dest_port='22 80 443 2023 1688'
uci -q set firewall.bypass_mgmt_allow.target='ACCEPT'
uci -q set firewall.bypass_mgmt_reject='rule'
uci -q set firewall.bypass_mgmt_reject.name='Reject-untrusted-management'
uci -q set firewall.bypass_mgmt_reject.src='lan'
uci -q set firewall.bypass_mgmt_reject.proto='tcp'
uci -q set firewall.bypass_mgmt_reject.dest_port='22 80 443 2023 1688'
uci -q set firewall.bypass_mgmt_reject.target='REJECT'
uci -q commit firewall

if uci -q get uhttpd.main >/dev/null; then
	uci -q delete uhttpd.main.listen_http
	uci -q add_list uhttpd.main.listen_http='127.0.0.1:80'
	uci -q add_list "uhttpd.main.listen_http=${staging_ip}:80"
	uci -q delete uhttpd.main.listen_https
	uci -q add_list uhttpd.main.listen_https='127.0.0.1:443'
	uci -q add_list "uhttpd.main.listen_https=${staging_ip}:443"
	uci -q set uhttpd.main.redirect_https='1'
	uci -q commit uhttpd
fi
if uci -q get daed.config >/dev/null; then
	uci -q set "daed.config.listen_addr=${staging_ip}:2023"
	uci -q commit daed
fi
if uci -q get mosdns.config >/dev/null; then
	uci -q set mosdns.config.listen_address='127.0.0.1'
	uci -q commit mosdns
fi
if uci -q get nlbwmon.@nlbwmon[0] >/dev/null 2>&1; then
	uci -q delete nlbwmon.@nlbwmon[0].local_network
	uci -q add_list "nlbwmon.@nlbwmon[0].local_network=${trusted_cidr}"
	uci -q commit nlbwmon
fi

printf 'Applying staging address %s. Reconnect after the network reload.\n' "$staging_ip"
"${INIT_DIR}/firewall" restart
"${INIT_DIR}/network" reload
"${INIT_DIR}/uhttpd" restart >/dev/null 2>&1 || true
"${INIT_DIR}/daed" restart >/dev/null 2>&1 || true
