#!/bin/sh

set -eu

BRIDGE='br-lan'
SAMPLE_SECONDS="${BYPASS_SAMPLE_SECONDS:-3}"
SYS_CLASS_NET="${BYPASS_SYS_CLASS_NET:-/sys/class/net}"
INIT_DIR="${BYPASS_INIT_DIR:-/etc/init.d}"

fail() {
	printf 'ERROR: %s\n' "$*" >&2
	exit 1
}

TARGET_IP="$(uci -q get bypass_router.main.target_ip)" \
	|| fail 'missing site configuration; run bypass-router-configure first'

bridge_ports() {
	for path in "${SYS_CLASS_NET}/${BRIDGE}/brif"/*; do
		[ -e "$path" ] || continue
		basename "$path"
	done
}

counter_sum() {
	interface="$1"
	rx="$(cat "${SYS_CLASS_NET}/${interface}/statistics/rx_bytes")"
	tx="$(cat "${SYS_CLASS_NET}/${interface}/statistics/tx_bytes")"
	printf '%s\n' "$((rx + tx))"
}

check_links() {
	[ -d "${SYS_CLASS_NET}/${BRIDGE}/brif" ] || fail "${BRIDGE} does not exist"
	ports="$(bridge_ports)"
	expected_ports="$(uci -q get bypass_router.main.bridge_port 2>/dev/null || true)"
	[ -n "$expected_ports" ] || expected_ports="$ports"
	for interface in $expected_ports; do
		[ -e "${SYS_CLASS_NET}/${BRIDGE}/brif/${interface}" ] \
			|| fail "expected bridge port ${interface} is missing from ${BRIDGE}"
	done

	before_file="$(mktemp '/tmp/bypass-router-links.XXXXXX')"
	trap 'rm -f "$before_file"' EXIT INT TERM
	for interface in $ports; do
		[ "$(cat "${SYS_CLASS_NET}/${interface}/carrier" 2>/dev/null || true)" = '1' ] \
			|| continue
		printf '%s %s\n' "$interface" "$(counter_sum "$interface")" >> "$before_file"
	done
	active_count="$(awk 'END { print NR }' "$before_file")"
	[ "$active_count" -ge 2 ] \
		|| fail "${BRIDGE} needs two active ports; found ${active_count}"

	sleep "$SAMPLE_SECONDS"
	while read -r interface before; do
		after="$(counter_sum "$interface")"
		[ "$after" -gt "$before" ] \
			|| fail "${interface} carried no traffic during the ${SAMPLE_SECONDS}s sample"
		printf 'OK: %s carrier=up delta_bytes=%s\n' "$interface" "$((after - before))"
	done < "$before_file"
	rm -f "$before_file"
	trap - EXIT INT TERM
}

update_bound_services() {
	address="$1"
	if uci -q get uhttpd.main >/dev/null; then
		uci -q delete uhttpd.main.listen_http
		uci -q add_list uhttpd.main.listen_http='127.0.0.1:80'
		uci -q add_list "uhttpd.main.listen_http=${address}:80"
		uci -q delete uhttpd.main.listen_https
		uci -q add_list uhttpd.main.listen_https='127.0.0.1:443'
		uci -q add_list "uhttpd.main.listen_https=${address}:443"
		uci -q commit uhttpd
	fi
	if uci -q get daed.config >/dev/null; then
		uci -q set "daed.config.listen_addr=${address}:2023"
		uci -q commit daed
	fi
}

check_runtime() {
	check_links
	pidof mosdns >/dev/null 2>&1 || fail 'mosdns is not running'
	pidof daed >/dev/null 2>&1 || fail 'daed is not running'
	current_ip="$(uci -q get network.lan.ipaddr)"
	printf 'OK: services running; current LAN address=%s\n' "$current_ip"
}

target_in_use() {
	ip neigh flush to "$TARGET_IP" dev "$BRIDGE" >/dev/null 2>&1 || true
	ping -c 1 -W 1 "$TARGET_IP" >/dev/null 2>&1 || true
	ip neigh show to "$TARGET_IP" dev "$BRIDGE" | grep -q 'lladdr'
}

case "${1:-}" in
	check)
		check_runtime
		printf 'READY: validate a real client through %s before cutover.\n' \
			"$(uci -q get network.lan.ipaddr)"
	;;
	apply)
		[ "${2:-}" = '--confirm' ] || fail "usage: $0 apply --confirm"
		check_runtime
		if target_in_use; then
			fail "${TARGET_IP} is still in use; shut down the old router first"
		fi
		uci -q set "network.lan.ipaddr=${TARGET_IP}"
		uci -q commit network
		update_bound_services "$TARGET_IP"
		printf 'Applying %s. This session may disconnect; reconnect to https://%s/.\n' \
			"$TARGET_IP" "$TARGET_IP"
		"${INIT_DIR}/network" reload
		"${INIT_DIR}/uhttpd" restart >/dev/null 2>&1 || true
		"${INIT_DIR}/daed" restart >/dev/null 2>&1 || true
	;;
	*)
		fail "usage: $0 {check|apply --confirm}"
	;;
esac
