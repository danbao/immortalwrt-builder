#!/bin/sh

set -eu

INIT_DIR="${BYPASS_INIT_DIR:-/etc/init.d}"

fail() {
	printf 'ERROR: %s\n' "$*" >&2
	exit 1
}

authorized_keys="${BYPASS_AUTHORIZED_KEYS:-/etc/dropbear/authorized_keys}"
[ -s "$authorized_keys" ] || fail "${authorized_keys} is empty; refusing to disable password login"

key_count="$(awk 'NF && $1 !~ /^#/ { count++ } END { print count + 0 }' "$authorized_keys")"
[ "$key_count" -gt 0 ] || fail 'no usable SSH public key found'

sections="$(uci -q show dropbear | sed -n "s/^\(dropbear\.[^.]*\)=dropbear$/\1/p")"
[ -n "$sections" ] || fail 'no dropbear configuration section found'
for section in $sections; do
	uci -q set "${section}.PasswordAuth=off"
	uci -q set "${section}.RootPasswordAuth=off"
done
uci -q commit dropbear

lan_ip="$(uci -q get network.lan.ipaddr)"
trusted_cidr="$(uci -q get bypass_router.main.trusted_cidr 2>/dev/null || true)"
if [ -z "$trusted_cidr" ]; then
	trusted_cidr="$(printf '%s' "$lan_ip" | awk -F. '{print $1 "." $2 "." $3 ".0/24"}')"
fi

if uci -q get uhttpd.main >/dev/null; then
	uci -q delete uhttpd.main.listen_http
	uci -q delete uhttpd.main.listen_https
	uci -q add_list "uhttpd.main.listen_https=${lan_ip}:443"
	uci -q set uhttpd.main.redirect_https='0'
	uci -q commit uhttpd
fi

if uci -q get daed.config >/dev/null; then
	uci -q set "daed.config.listen_addr=${lan_ip}:2023"
	uci -q commit daed
fi

if uci -q get mosdns.config >/dev/null; then
	uci -q set mosdns.config.listen_address=127.0.0.1
	uci -q set mosdns.config.listen_port=5335
	uci -q set mosdns.config.listen_port_api=9091
	uci -q set mosdns.config.remote_dns='https://dns.google/dns-query https://dns11.quad9.net/dns-query'
	uci -q set mosdns.config.insecure_skip_verify=0
	uci -q commit mosdns
fi

if uci -q get dhcp.lan >/dev/null; then
	uci -q set dhcp.lan.ignore='1'
	uci -q set dhcp.lan.ra='disabled'
	uci -q set dhcp.lan.dhcpv6='disabled'
	uci -q commit dhcp
fi

lan_zone="$(uci -q show firewall | sed -n "s/^\(firewall\.[^.]*\)\.name='lan'$/\1/p" | head -n 1)"
[ -n "$lan_zone" ] || fail 'LAN firewall zone not found'
uci -q set "${lan_zone}.input=REJECT"

uci -q set firewall.bypass_dns_allow='rule'
uci -q set firewall.bypass_dns_allow.name='Allow-trusted-DNS'
uci -q set firewall.bypass_dns_allow.src='lan'
uci -q set "firewall.bypass_dns_allow.src_ip=${trusted_cidr}"
uci -q set firewall.bypass_dns_allow.family='ipv4'
uci -q set firewall.bypass_dns_allow.proto='tcp udp'
uci -q set firewall.bypass_dns_allow.dest_port='53'
uci -q set firewall.bypass_dns_allow.target='ACCEPT'

uci -q set firewall.bypass_mgmt_allow='rule'
uci -q set firewall.bypass_mgmt_allow.name='Allow-trusted-management'
uci -q set firewall.bypass_mgmt_allow.src='lan'
uci -q set "firewall.bypass_mgmt_allow.src_ip=${trusted_cidr}"
uci -q set firewall.bypass_mgmt_allow.family='ipv4'
uci -q set firewall.bypass_mgmt_allow.proto='tcp'
uci -q set firewall.bypass_mgmt_allow.dest_port='22 443 2023'
uci -q set firewall.bypass_mgmt_allow.target='ACCEPT'

uci -q set firewall.bypass_kms_allow='rule'
uci -q set firewall.bypass_kms_allow.name='Allow-trusted-KMS'
uci -q set firewall.bypass_kms_allow.src='lan'
uci -q set "firewall.bypass_kms_allow.src_ip=${trusted_cidr}"
uci -q set firewall.bypass_kms_allow.family='ipv4'
uci -q set firewall.bypass_kms_allow.proto='tcp'
uci -q set firewall.bypass_kms_allow.dest_port='1688'
uci -q set firewall.bypass_kms_allow.target='ACCEPT'

uci -q set firewall.bypass_icmp_allow='rule'
uci -q set firewall.bypass_icmp_allow.name='Allow-trusted-ICMP'
uci -q set firewall.bypass_icmp_allow.src='lan'
uci -q set "firewall.bypass_icmp_allow.src_ip=${trusted_cidr}"
uci -q set firewall.bypass_icmp_allow.family='ipv4'
uci -q set firewall.bypass_icmp_allow.proto='icmp'
uci -q delete firewall.bypass_icmp_allow.icmp_type
uci -q add_list firewall.bypass_icmp_allow.icmp_type='echo-request'
uci -q add_list firewall.bypass_icmp_allow.icmp_type='destination-unreachable'
uci -q add_list firewall.bypass_icmp_allow.icmp_type='time-exceeded'
uci -q set firewall.bypass_icmp_allow.target='ACCEPT'
uci -q delete firewall.bypass_mgmt_reject
uci -q commit firewall

if uci -q get nlbwmon.@nlbwmon[0] >/dev/null 2>&1; then
	uci -q delete nlbwmon.@nlbwmon[0].local_network
	uci -q add_list "nlbwmon.@nlbwmon[0].local_network=${trusted_cidr}"
	uci -q commit nlbwmon
fi

if [ -x "${INIT_DIR}/tailscale" ]; then
	"${INIT_DIR}/tailscale" disable
	"${INIT_DIR}/tailscale" stop >/dev/null 2>&1 || true
fi

"${INIT_DIR}/dropbear" restart
"${INIT_DIR}/uhttpd" restart >/dev/null 2>&1 || true
"${INIT_DIR}/firewall" restart
"${INIT_DIR}/mosdns" restart >/dev/null 2>&1 || true
"${INIT_DIR}/daed" restart >/dev/null 2>&1 || true
"${INIT_DIR}/dnsmasq" restart >/dev/null 2>&1 || true
"${INIT_DIR}/odhcpd" restart >/dev/null 2>&1 || true
if [ -x "${INIT_DIR}/nlbwmon" ]; then
	"${INIT_DIR}/nlbwmon" restart >/dev/null 2>&1 || true
fi
if [ -x "/usr/sbin/bypass-router-apply-sysctl" ]; then
	"/usr/sbin/bypass-router-apply-sysctl"
fi
printf 'Hardened: trusted=%s; SSH key-only; LuCI HTTPS-only on %s.\n' "$trusted_cidr" "$lan_ip"
