#!/bin/sh

set -eu

INIT_DIR="${BYPASS_INIT_DIR:-/etc/init.d}"

fail() {
	printf 'ERROR: %s\n' "$*" >&2
	exit 1
}

authorized_keys="${BYPASS_AUTHORIZED_KEYS:-/etc/dropbear/authorized_keys}"
[ -s "$authorized_keys" ] || fail "${authorized_keys} is empty; refusing to disable password login"

key_count="$(awk 'NF && $1 !~ /^#/ { count++ } END { print count + 0 }' "$authorized_keys")"
[ "$key_count" -gt 0 ] || fail 'no usable SSH public key found'

sections="$(uci -q show dropbear | sed -n "s/^\(dropbear\.[^.]*\)=dropbear$/\1/p")"
[ -n "$sections" ] || fail 'no dropbear configuration section found'
for section in $sections; do
	uci -q set "${section}.PasswordAuth=off"
	uci -q set "${section}.RootPasswordAuth=off"
done
uci -q commit dropbear

lan_ip="$(uci -q get network.lan.ipaddr)"
if uci -q get uhttpd.main >/dev/null; then
	uci -q delete uhttpd.main.listen_http
	uci -q delete uhttpd.main.listen_https
	uci -q add_list "uhttpd.main.listen_https=${lan_ip}:443"
	uci -q set uhttpd.main.redirect_https='0'
	uci -q commit uhttpd
fi

"${INIT_DIR}/dropbear" restart
"${INIT_DIR}/uhttpd" restart >/dev/null 2>&1 || true
printf 'Hardened: password SSH disabled; LuCI is HTTPS-only on %s.\n' "$lan_ip"
