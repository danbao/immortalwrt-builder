#!/bin/sh
# shellcheck shell=dash
# GraphQL variables intentionally use literal dollar signs in single quotes.
# shellcheck disable=SC2016

set -eu
umask 077

OBJECT_ID_HELPER="${DAED_OBJECT_ID_HELPER:-/usr/share/luci-app-daede/daed-object-id.uc}"
SYNC_COMMAND="${DAED_SYNC_COMMAND:-/usr/local/sbin/daed-subscription-sync}"
CRONTAB="${BYPASS_CRONTAB:-/etc/crontabs/root}"
UCI_CONFIG="${BYPASS_UCI_CONFIG:-/etc/config/bypass_router}"
TMPDIR=''
TOKEN=''
GRAPHQL_URL=''

fail() {
	printf 'ERROR: %s\n' "$*" >&2
	exit 1
}

cleanup() {
	[ -z "$TMPDIR" ] || rm -rf "$TMPDIR"
}

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

valid_ipv4() {
	awk -F. '
		NF != 4 { exit 1 }
		{ for (i = 1; i <= 4; i++) if ($i !~ /^[0-9]+$/ || $i > 255) exit 1 }
	' <<EOF
$1
EOF
}

usage() {
	fail "usage: $0 SUBSCRIPTION_TAG [--resolver IPV4] --confirm"
}

post_graphql() {
	local body="$1"
	local output="$2"
	local auth="${3:-}"
	if [ -n "$auth" ]; then
		printf 'header = "Authorization: Bearer %s"\n' "$auth" | \
			curl --config - --max-time 90 -fsS "$GRAPHQL_URL" \
				-H 'Content-Type: application/json' \
				--data-binary "@$body" > "$output"
	else
		curl --max-time 30 -fsS "$GRAPHQL_URL" \
			-H 'Content-Type: application/json' \
			--data-binary "@$body" > "$output"
	fi
}

graphql_checked() {
	local body="$1"
	local output="$2"
	post_graphql "$body" "$output" "$TOKEN" || fail 'daed GraphQL request failed'
	grep -q '"errors"' "$output" && fail 'daed GraphQL returned an error'
	return 0
}

run_mutation() {
	local name="$1"
	local query="$2"
	local variables="$3"
	local body="$TMPDIR/${name}-body.json"
	local output="$TMPDIR/${name}-response.json"
	printf '{"query":"%s","variables":%s}' "$query" "$variables" > "$body"
	graphql_checked "$body" "$output"
}

find_id() {
	local file="$1"
	local collection="$2"
	local value="$3"
	"$OBJECT_ID_HELPER" "$file" "$collection" "$value"
}

[ "$#" -ge 2 ] || usage
SUBSCRIPTION_TAG="$1"
[ -n "$SUBSCRIPTION_TAG" ] || usage
shift
DIRECT_RESOLVER=''
confirmed=0
while [ "$#" -gt 0 ]; do
	case "$1" in
		--resolver)
			[ "$#" -ge 2 ] || usage
			DIRECT_RESOLVER="$2"
			shift 2
		;;
		--confirm)
			confirmed=1
			shift
		;;
		*) usage ;;
	esac
done
[ "$confirmed" = '1' ] || usage
if [ -n "$DIRECT_RESOLVER" ]; then
	valid_ipv4 "$DIRECT_RESOLVER" || fail 'resolver is not a valid IPv4 address'
fi

pidof daed >/dev/null 2>&1 || fail 'daed is not running'
USERNAME="$(uci -q get daed.config.dashboard_username 2>/dev/null || true)"
PASSWORD="$(uci -q get daed.config.dashboard_password 2>/dev/null || true)"
if [ -z "$USERNAME" ] || [ -z "$PASSWORD" ]; then
	fail 'configure daed credentials in LuCI first'
fi
[ -x "$OBJECT_ID_HELPER" ] || fail 'daed object lookup helper is missing'
[ -x "$SYNC_COMMAND" ] || fail 'daed subscription sync command is missing'

LISTEN_ADDR="$(uci -q get daed.config.listen_addr 2>/dev/null || true)"
[ -n "$LISTEN_ADDR" ] || LISTEN_ADDR='127.0.0.1:2023'
case "$LISTEN_ADDR" in
	0.0.0.0:*) LISTEN_ADDR="127.0.0.1:${LISTEN_ADDR##*:}" ;;
	\[::\]:*) LISTEN_ADDR="127.0.0.1:${LISTEN_ADDR##*:}" ;;
esac
GRAPHQL_URL="http://${LISTEN_ADDR}/graphql"

trap cleanup EXIT INT TERM
TMPDIR="$(mktemp -d '/tmp/bypass-router-daed-configure.XXXXXX')" \
	|| fail 'failed to create temporary directory'
login_body="$TMPDIR/login-body.json"
login_response="$TMPDIR/login-response.json"
printf '{"query":"query Token($username:String!,$password:String!){token(username:$username,password:$password)}","variables":{"username":"%s","password":"%s"}}' \
	"$(json_escape "$USERNAME")" "$(json_escape "$PASSWORD")" > "$login_body"
post_graphql "$login_body" "$login_response" || fail 'daed login request failed'
TOKEN="$(jsonfilter -i "$login_response" -e '@.data.token')"
[ -n "$TOKEN" ] || fail 'daed login failed'

state_body="$TMPDIR/state-body.json"
state="$TMPDIR/state.json"
printf '%s' '{"query":"query SetupState{configs{id name selected} routings{id name selected} groups{id name policy} subscriptions{id tag}}"}' > "$state_body"
graphql_checked "$state_body" "$state"

SUB_ID="$(find_id "$state" subscriptions "$SUBSCRIPTION_TAG")"
[ -n "$SUB_ID" ] || fail 'requested subscription does not exist in daed'
CONFIG_ID="$(find_id "$state" configs bypass-router)"
ROUTING_ID="$(find_id "$state" routings bypass-router)"
GROUP_ID="$(find_id "$state" groups proxy)"

global_variables='{"name":"bypass-router","global":{"lanInterface":["br-lan"],"wanInterface":["auto"],"autoConfigKernelParameter":true,"autoConfigFirewallRule":false}}'
if [ -n "$CONFIG_ID" ]; then
	run_mutation 'update-config' \
		'mutation UpdateConfig($id:ID!,$global:globalInput!){updateConfig(id:$id,global:$global){id name}}' \
		"{\"id\":\"$(json_escape "$CONFIG_ID")\",\"global\":{\"lanInterface\":[\"br-lan\"],\"wanInterface\":[\"auto\"],\"autoConfigKernelParameter\":true,\"autoConfigFirewallRule\":false}}"
else
	run_mutation 'create-config' \
		'mutation CreateConfig($name:String!,$global:globalInput!){createConfig(name:$name,global:$global){id name}}' \
		"$global_variables"
	CONFIG_ID="$(jsonfilter -i "$TMPDIR/create-config-response.json" -e '@.data.createConfig.id')"
fi
[ -n "$CONFIG_ID" ] || fail 'failed to create the bypass-router daed config'

routing_json='pname(NetworkManager, systemd-resolved, dnsmasq) -> must_direct\ndip(geoip:private) -> direct\ndip(geoip:cn) -> direct\ndomain(geosite:category-ai-!cn) -> proxy\ndomain(geosite:cn) -> direct\nfallback: proxy'
if [ -n "$ROUTING_ID" ]; then
	run_mutation 'update-routing' \
		'mutation UpdateRouting($id:ID!,$routing:String!){updateRouting(id:$id,routing:$routing){id name}}' \
		"{\"id\":\"$(json_escape "$ROUTING_ID")\",\"routing\":\"$routing_json\"}"
else
	run_mutation 'create-routing' \
		'mutation CreateRouting($name:String!,$routing:String!){createRouting(name:$name,routing:$routing){id name}}' \
		"{\"name\":\"bypass-router\",\"routing\":\"$routing_json\"}"
	ROUTING_ID="$(jsonfilter -i "$TMPDIR/create-routing-response.json" -e '@.data.createRouting.id')"
fi
[ -n "$ROUTING_ID" ] || fail 'failed to create the bypass-router daed routing'

if [ -n "$GROUP_ID" ]; then
	run_mutation 'set-group-policy' \
		'mutation Policy($id:ID!,$policy:Policy!){groupSetPolicy(id:$id,policy:$policy)}' \
		"{\"id\":\"$(json_escape "$GROUP_ID")\",\"policy\":\"min_moving_avg\"}"
else
	run_mutation 'create-group' \
		'mutation Group($name:String!,$policy:Policy!){createGroup(name:$name,policy:$policy){id name policy}}' \
		'{"name":"proxy","policy":"min_moving_avg"}'
	GROUP_ID="$(jsonfilter -i "$TMPDIR/create-group-response.json" -e '@.data.createGroup.id')"
fi
[ -n "$GROUP_ID" ] || fail 'failed to create the proxy group'

run_mutation 'select-config' \
	'mutation SelectConfig($id:ID!){selectConfig(id:$id)}' \
	"{\"id\":\"$(json_escape "$CONFIG_ID")\"}"
run_mutation 'select-routing' \
	'mutation SelectRouting($id:ID!){selectRouting(id:$id)}' \
	"{\"id\":\"$(json_escape "$ROUTING_ID")\"}"
run_mutation 'validate' 'mutation Validate($dry:Boolean!){run(dry:$dry)}' '{"dry":true}'

[ -e "$UCI_CONFIG" ] || {
	: > "$UCI_CONFIG" || fail 'failed to create the bypass-router UCI config'
	chmod 0600 "$UCI_CONFIG" || fail 'failed to secure the bypass-router UCI config'
}
uci -q set bypass_router.daed='daed'
uci -q set "bypass_router.daed.subscription_tag=${SUBSCRIPTION_TAG}"
uci -q set bypass_router.daed.group='proxy'
uci -q set bypass_router.daed.exclude_keyword='备用'
if [ -n "$DIRECT_RESOLVER" ]; then
	uci -q set "bypass_router.daed.direct_resolver=${DIRECT_RESOLVER}"
else
	uci -q delete bypass_router.daed.direct_resolver
fi
uci -q commit bypass_router

"$SYNC_COMMAND"

mkdir -p "$(dirname "$CRONTAB")"
cron_tmp="$(mktemp "${CRONTAB}.XXXXXX")" || fail 'failed to create temporary crontab'
if [ -f "$CRONTAB" ]; then
	sed '/daed-codeap-sync/d;/daed-subscription-sync/d' "$CRONTAB" > "$cron_tmp"
fi
printf '%s\n' '17 */6 * * * /usr/local/sbin/daed-subscription-sync >/tmp/daed-subscription-cron.log 2>&1 # filtered daed subscription sync' \
	>> "$cron_tmp"
mv "$cron_tmp" "$CRONTAB"

printf 'Configured daed public defaults for subscription tag %s.\n' "$SUBSCRIPTION_TAG"
